{
  "name": "ccusage-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.js",
    "dev": "bun --watch src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun --no-env-file scripts/tests.js unit",
    "test:contract": "bun --no-env-file scripts/tests.js contract",
    "test:e2e": "bun --no-env-file scripts/tests.js e2e",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:contract"
  },
  "dependencies": {
    "ccusage": "20.0.31"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.3",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0"
  }
}
